$TTL    604800
@       IN      SOA     ns1.empresa.local. admin.empresa.local. (
                  2026090805      ; Serial (AAAAMMDDNN)
                  3600            ; Refresh
                  1800            ; Retry
                  604800          ; Expire
                  86400 )         ; Minimum TTL


@       IN      NS      maestro.empresa.local.
@       IN      NS      esclavo.empresa.local.
@       IN      MX  10  mail.empresa.local.

maestro IN      A       192.168.50.3
esclavo IN      A       192.168.50.2
ns1     IN      A       192.168.50.3
ns2     IN      A       192.168.50.2
www     IN      A       192.168.50.3
mail    IN      A       192.168.50.11
parcial IN      A       192.168.50.3







ns1     IN      AAAA    fe80::1
ns2     IN      AAAA    fe80::2
www     IN      AAAA    fe80::3
mail    IN      AAAA    fe80::4


prueba  IN      A       192.168.50.3
ftp     IN      CNAME   www
